#-----------------------Database---------------------------
# Local dev: SQLite file in the backend folder
DATABASE_URL=sqlite:///./pizza_delivery.db

#-----------------------Imp Server Details---------------
# Generate keys with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
REFRESH_SECRET_KEY=change-me-too
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

#-----------------------Password reset e-mails------------
# Where the reset link in the e-mail points (your frontend URL).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# SMTP server for sending e-mail. Leave SMTP_HOST empty in development:
# the reset link is then printed in the backend terminal instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<16-character Google "App password">, SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
