# Copy to docker/.env.staging and fill in real values. Never commit .env.staging.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# Environment name. Destructive manage.py commands (reset-db, clear-orders)
# refuse to run when this is "production".
APP_ENV=staging

SECRET_KEY=replace-with-a-long-random-string
REFRESH_SECRET_KEY=replace-with-a-different-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
